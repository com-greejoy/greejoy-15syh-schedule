# 生产环境配置
ENV = 'production'

# 生产环境
VUE_APP_PREFIX = ''
VUE_APP_BASE_API = '/syh/back'
VUE_APP_HOST_URL = 'https://www.sichuan15sports.cn/'

# 允许显示的组别 code，逗号分隔，留空则显示全部。例: public,young
VUE_APP_ALLOWED_CATEGORIES = 'public,young'

# 青少年组电子证书 SPA 部署地址（sc-athlete-cert），用于运动员详情页跳转
# 拼接形式：${VUE_APP_CERT_URL}#/query/${certNumber}（末尾 / 必须保留）
VUE_APP_CERT_URL = 'http://202.61.91.5:4321/apps/sc-athlete-certsyh/'
